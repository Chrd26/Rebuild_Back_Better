[submodule "modules/SDL"]
	path = modules/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "modules/SDL_ttf"]
	path = modules/SDL_ttf
	url = https://github.com/libsdl-org/SDL_ttf.git
[submodule "modules/cpplocate"]
	path = modules/cpplocate
	url = git@github.com:cginternals/cpplocate.git
[submodule "modules/SDL_mixer"]
	path = modules/SDL_mixer
	url = git@github.com:libsdl-org/SDL_mixer.git
[submodule "modules/SDL_image"]
	path = modules/SDL_image
	url = git@github.com:libsdl-org/SDL_image.git
